diff --git a/src/Formalism/FiniteIndexAveraging.lean b/src/Formalism/FiniteIndexAveraging.lean
new file mode 100644
index 0000000000000000000000000000000000000000..4cdf5c4a2614af971b1716778478194f4a56a2ea
--- /dev/null
+++ b/src/Formalism/FiniteIndexAveraging.lean
@@ -0,0 +1,47 @@
+import Mathlib.GroupTheory.Index
+import Mathlib.Algebra.BigOperators.Module
+import Mathlib.Algebra.Module.LinearMap.Basic
+import Mathlib.Tactic.Abel
+
+/-- A cocycle over a characteristic-zero field that is a coboundary on a finite-index subgroup is a coboundary on the whole group. -/
+theorem Formalism.GroupCohomology.coboundary_of_finite_index {k G W : Type} [Field k] [CharZero k] [Group G] [AddCommGroup W] [Module k W]
+    (a : G → W →ₗ[k] W) (hmul : ∀ g h w, a (g * h) w = a g (a h w)) (f : G → W)
+    (hf : ∀ g h, f (g * h) = f g + a g (f h)) (H : Subgroup G) [H.FiniteIndex] (x : W)
+    (hx : ∀ h ∈ H, f h = a h x - x) : ∃ y, ∀ g, f g = a g y - y := by
+  classical
+  haveI : Fintype (G ⧸ H) := Fintype.ofFinite _
+  set f' : G → W := fun g => f g - (a g x - x) with hf'
+  have hc : ∀ g h, f' (g * h) = f' g + a g (f' h) := by
+    intro g h
+    simp only [hf', hf, hmul, map_sub]
+    abel
+  have hH : ∀ g h, h ∈ H → f' (g * h) = f' g := by
+    intro g h hh
+    rw [hc]
+    have : f' h = 0 := by simp only [hf', hx h hh, sub_self]
+    rw [this, map_zero, add_zero]
+  let F : G ⧸ H → W := Quotient.lift f' (by
+    intro g g' hgg
+    have h1 : g⁻¹ * g' ∈ H := QuotientGroup.leftRel_apply.1 hgg
+    have := hH g _ h1
+    rw [mul_inv_cancel_left] at this
+    exact this.symm)
+  have hF : ∀ (g : G) (q : G ⧸ H), F (g • q) = f' g + a g (F q) := by
+    intro g q
+    induction q using QuotientGroup.induction_on with
+    | H z => exact hc g z
+  set S : W := ∑ q, F q with hS
+  have hsum : ∀ g, S = (Fintype.card (G ⧸ H) : k) • f' g + a g S := by
+    intro g
+    have e1 : ∑ q, F (g • q) = S := Equiv.sum_comp (MulAction.toPerm g) F
+    refine e1.symm.trans ?_
+    simp only [hF, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, ← map_sum,
+      Nat.cast_smul_eq_nsmul, ← hS]
+  have hn : (Fintype.card (G ⧸ H) : k) ≠ 0 := Nat.cast_ne_zero.2 Fintype.card_ne_zero
+  refine ⟨x - (Fintype.card (G ⧸ H) : k)⁻¹ • S, fun g => ?_⟩
+  have e : f' g = (Fintype.card (G ⧸ H) : k)⁻¹ • (S - a g S) := by
+    rw [eq_inv_smul_iff₀ hn, eq_sub_iff_add_eq]
+    exact (hsum g).symm
+  have e2 : f g = f' g + (a g x - x) := by simp only [hf', sub_add_cancel]
+  rw [e2, e, map_sub, map_smul, smul_sub]
+  abel
diff --git a/src/Formalism/GammaFactorNonvanishing/PrimitiveReduction.lean b/src/Formalism/GammaFactorNonvanishing/PrimitiveReduction.lean
new file mode 100644
index 0000000000000000000000000000000000000000..155fd37b8ff6dd85cf8b3e62cb666b4c54e170b3
--- /dev/null
+++ b/src/Formalism/GammaFactorNonvanishing/PrimitiveReduction.lean
@@ -0,0 +1,31 @@
+import Mathlib.NumberTheory.LSeries.DirichletContinuation
+
+namespace Formalism.DirichletReduction
+
+theorem factor_ne_zero {N : ℕ} (χ : DirichletCharacter ℂ N) {s : ℂ}
+    (hs : 0 < s.re) (p : ℕ) (hp : p.Prime) : (1 : ℂ) - χ p * (p : ℂ) ^ (-s) ≠ 0 := by
+  have h : ‖χ p * (p : ℂ) ^ (-s)‖ < 1 := by
+    rw [norm_mul]
+    refine (mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)).trans_lt ?_
+    rw [Complex.norm_natCast_cpow_of_pos hp.pos, Complex.neg_re]
+    exact Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast hp.one_lt) (neg_neg_of_pos hs)
+  intro hzero
+  rw [← sub_eq_zero.mp hzero, norm_one] at h
+  exact lt_irrefl _ h
+
+theorem primitive_ne_one_or_ne_pole {N : ℕ} (χ : DirichletCharacter ℂ N) {s : ℂ}
+    (h : χ ≠ 1 ∨ s ≠ 1) : χ.primitiveCharacter ≠ 1 ∨ s ≠ 1 :=
+  h.imp_left fun hχ hprim => hχ (by
+    rw [← χ.changeLevel_primitiveCharacter, hprim, DirichletCharacter.changeLevel_one])
+
+theorem zero_iff_primitive {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N)
+    [NeZero χ.conductor] {s : ℂ} (hs : 0 < s.re) (h : χ ≠ 1 ∨ s ≠ 1) :
+    χ.LFunction s = 0 ↔ χ.primitiveCharacter.LFunction s = 0 := by
+  have hL := DirichletCharacter.LFunction_changeLevel χ.conductor_dvd_level
+    χ.primitiveCharacter (primitive_ne_one_or_ne_pole χ h)
+  rw [χ.changeLevel_primitiveCharacter] at hL
+  have hprod := Finset.prod_ne_zero_iff.mpr (fun p (hp : p ∈ N.primeFactors) =>
+    factor_ne_zero χ.primitiveCharacter hs p (Nat.prime_of_mem_primeFactors hp))
+  simp [hL, hprod]
+
+end Formalism.DirichletReduction
